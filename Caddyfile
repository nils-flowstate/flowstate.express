# Caddy im Container: liefert die offene Willkommensseite von flowstate.express
# aus. Kein Lockscreen, keine Anmeldung, keine Cookies, kein Zugriffsprotokoll.
#
# Dieser Caddy ist NICHT der Reverse Proxy des Servers. Namen und TLS besorgt
# der zentrale Caddy (/home/nils/caddy/Caddyfile, siehe
# docker/Caddyfile.zentral.txt).
{
	admin off
	auto_https off
	persist_config off
}

:3013 {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Frame-Options "DENY"
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src 'self' data:; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		-Server
	}

	handle /health {
		respond "ok" 200
	}

	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond <<TEXT
			User-agent: *
			Allow: /
			TEXT 200
	}

	handle {
		header /assets/* Cache-Control "public, max-age=604800"
		header / Cache-Control "no-cache"
		file_server
	}
}
