# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prototyp-Screenshots: Originale bleiben lokal, ausgeliefert wird nur das
# komprimierte WebP in public/images/prototype/
public/images/prototype/og/*
!public/images/prototype/og/README.md
!public/images/prototype/og/mapping.txt

# Gamescom: dasselbe für die Screens der Geschichtenwelt — und für den
# Rohmitschnitt (15 MB .mov), aus dem public/video/geschichtenwelt.* entsteht.
public/images/gamescom/og/*
!public/images/gamescom/og/mapping.txt
